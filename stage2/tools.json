{
  "transport": "JSON-RPC 2.0 / stdio для чтения; локальная транзакция для сохранения предложения",
  "servers": {
    "MCP-TICKETS": {
      "tickets.get": {
        "input": {
          "id": "номер текущей заявки"
        },
        "access": "чтение в границах организации"
      },
      "transport": "stdio · mcp_stdio.py"
    },
    "MCP-KB": {
      "kb.search": {
        "input": {
          "topic": "категория"
        },
        "access": "чтение утверждённых статей"
      },
      "transport": "stdio · mcp_stdio.py"
    }
  },
  "localAdapters": {
    "proposal.save": {
      "input": {
        "source": "ID выданной статьи",
        "draft": "текст",
        "confidence": "0..1"
      },
      "access": "запись черновика текущей заявки"
    }
  },
  "planned": {
    "MCP-TICKETS": {
      "tickets.search_similar": {
        "input": {
          "id": "номер текущей заявки"
        },
        "access": "чтение закрытых решённых заявок той же организации, не больше 5"
      }
    },
    "MCP-STAFF": {
      "staff.get_candidates": {
        "input": {
          "id": "номер текущей заявки"
        },
        "access": "инженеры, прошедшие фильтр компетенций и уровня; только имя"
      },
      "staff.get_history_with_org": {
        "input": {
          "engineer": "имя инженера",
          "org": "организация заявки"
        },
        "access": "число заявок организации у инженера"
      }
    },
    "note": "Проектные инструменты для предложений А1–А3. В прототипе не исполняются и не входят в разрешённый список."
  }
}
