<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_STP" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_STP">
    <bpmn:participant id="Participant_STP" name="Обработка обращения в СТП (вариант 12)" processRef="Process_STP" />
  </bpmn:collaboration>
  <bpmn:process id="Process_STP" name="Обработка обращения в СТП" isExecutable="false">
    <bpmn:documentation>Модель автоматизируемого процесса по кейсу 12. Правила BR-xx и допущения ASM-xx — docs/01-process-analysis.md.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_STP">
      <bpmn:lane id="Lane_Client" name="Клиент (сотрудник организации-клиента)">
        <bpmn:flowNodeRef>SE_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ClientReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BT_3days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Solved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="ИУС СТП (детерминированное ядро)">
        <bpmn:flowNodeRef>T_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_StartSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_SLA1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_SLA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Breach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Breach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Breach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_FirstResp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_SLAOk1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_FirstResp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_SLAOk2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ITE_FirstResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_Reopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Reopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_2weeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="ИИ-ассистент (только предлагает)">
        <bpmn:flowNodeRef>T_AIProposal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineer" name="Инженер ТП">
        <bpmn:flowNodeRef>GW_Free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Competent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RemoteDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CloseNoReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CloseDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head" name="Руководитель подразделения ТП">
        <bpmn:flowNodeRef>T_HeadAssign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_Need" name="Возникла потребность в помощи">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Submit" name="Заполнить заявку на портале и нажать «Send»">
      <bpmn:documentation>BR-01. Клиент указывает тему, описание, тип, приоритет, инсталляцию.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ClientReview" name="Изучить ответ, дать информацию или обратную связь">
      <bpmn:documentation>BR-21, BR-22. Клиент предоставляет запрошенную информацию или сообщает, помогло ли решение.</bpmn:documentation>
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BT_3days" name="3 рабочих дня без ответа клиента" cancelActivity="true" attachedToRef="T_ClientReview">
      <bpmn:documentation>BR-19. Отсчёт от последнего ответа инженера, рабочие дни по производственному календарю (ASM-07).</bpmn:documentation>
      <bpmn:outgoing>F43</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_BT_3days" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Solved" name="Вопрос решён?">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Register" name="Зарегистрировать заявку: ES-NNNN, Waiting for support">
      <bpmn:documentation>BR-02, BR-03, BR-04. ID = «ES-» + 4 цифры; организация и автор; исполнитель Unassigned.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_Split">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_StartSLA" name="Рассчитать дедлайн первого ответа по SLA">
      <bpmn:documentation>BR-07, BR-08. Дедлайн = регистрация + норматив SLA организации для приоритета (ASM-01).</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="EBG_SLA1">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Warn" name="За 1 ч до дедлайна">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_ICE_Warn" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T_Warn" name="Предупредить инженеров по e-mail">
      <bpmn:documentation>BR-11, ASM-02, ASM-10.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="EBG_SLA2">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Breach" name="Дедлайн истёк">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_ICE_Breach" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T_Breach" name="Зафиксировать нарушение SLA, уведомить инженеров и руководителя">
      <bpmn:documentation>BR-10.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EE_Breach" name="SLA нарушен">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ICE_FirstResp1" name="Первый ответ">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SED_ICE_FirstResp1" signalRef="Signal_FirstResponse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE_SLAOk1" name="SLA соблюдён">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ICE_FirstResp2" name="Первый ответ">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SED_ICE_FirstResp2" signalRef="Signal_FirstResponse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE_SLAOk2" name="SLA соблюдён">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_Notify" name="Уведомить о новой заявке (e-mail, Slack)">
      <bpmn:documentation>BR-12.</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_RecordResponse" name="Зафиксировать ответ, перевести в Waiting for customer">
      <bpmn:documentation>BR-05, BR-09, BR-16, BR-18. Первый ответ назначает исполнителя и отмечает соблюдение SLA.</bpmn:documentation>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ITE_FirstResp" name="Первый ответ опубликован">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SED_ITE_FirstResp" signalRef="Signal_FirstResponse" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="T_Close" name="Перевести в статус Closed, уведомить">
      <bpmn:documentation>BR-22, ASM-04.</bpmn:documentation>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="EBG_Reopen">
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Reopen" name="Клиент возобновил заявку">
      <bpmn:documentation>BR-20.</bpmn:documentation>
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ICE_Reopen" messageRef="Message_Reopen" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ICE_2weeks" name="Прошло 2 недели">
      <bpmn:incoming>F48</bpmn:incoming>
      <bpmn:outgoing>F49</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_ICE_2weeks"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE_Closed" name="Заявка закрыта окончательно">
      <bpmn:incoming>F49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_AIProposal" name="Подготовить предложение: тип, приоритет, исполнитель, черновик">
      <bpmn:documentation>Требования ИИ-01…ИИ-12. Только предложение; при недоступности — процесс идёт без него (ИИ-08).</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Free" name="Есть свободный инженер?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Take" name="Взять заявку в работу">
      <bpmn:documentation>BR-13.</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Merge1">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_MergeLoop">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Check" name="Проверить приоритет и инсталляцию, рассмотреть проблему">
      <bpmn:documentation>BR-14 и диагностика. Неточность инсталляции исправить; при несоответствии приоритета запросить обоснование у клиента; затем рассмотреть проблему (при возврате «не помогло» — повторная диагностика, BR-21).</bpmn:documentation>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Competent" name="Хватает компетенции?">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Escalate" name="Эскалировать на более опытного инженера">
      <bpmn:documentation>BR-15, BR-06, ASM-12.</bpmn:documentation>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Merge2">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Info" name="Хватает данных?">
      <bpmn:documentation>Достаточно ли диагностической информации для решения (BR-16, BR-17).</bpmn:documentation>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Extended" name="Расширенная поддержка?">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RemoteDiag" name="Собрать диагностику удалённо">
      <bpmn:documentation>BR-17. Временную приостановку ПО согласовать с клиентом. ИИ-ассистенту доступ запрещён.</bpmn:documentation>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RequestInfo" name="Запросить диагностическую информацию у клиента">
      <bpmn:documentation>BR-16.</bpmn:documentation>
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Answer" name="Подготовить и опубликовать решение">
      <bpmn:documentation>Инженер может использовать черновик ассистента только после утверждения (принцип P2).</bpmn:documentation>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Merge3">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_CloseNoReply" name="Закрыть по отсутствию ответа?">
      <bpmn:documentation>BR-19: после 3 рабочих дней без ответа клиента появляется возможность закрыть заявку; решение принимает инженер.</bpmn:documentation>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
      <bpmn:outgoing>F51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_CloseDecision" name="Закрыть заявку с указанием причины">
      <bpmn:documentation>BR-19, BR-22, ASM-06. Причина: «решено» или «нет ответа клиента».</bpmn:documentation>
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_HeadAssign" name="Пересмотреть приоритеты и назначить инженера">
      <bpmn:documentation>BR-13. Учитываются занятость, компетентность, история работы с клиентом (и рекомендация ассистента).</bpmn:documentation>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F01" sourceRef="SE_Need" targetRef="T_Submit" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_Submit" targetRef="T_Register" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_Register" targetRef="GW_Split" />
    <bpmn:sequenceFlow id="F04" sourceRef="GW_Split" targetRef="T_StartSLA" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_StartSLA" targetRef="EBG_SLA1" />
    <bpmn:sequenceFlow id="F06" sourceRef="EBG_SLA1" targetRef="ICE_Warn" />
    <bpmn:sequenceFlow id="F07" sourceRef="ICE_Warn" targetRef="T_Warn" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_Warn" targetRef="EBG_SLA2" />
    <bpmn:sequenceFlow id="F09" sourceRef="EBG_SLA2" targetRef="ICE_Breach" />
    <bpmn:sequenceFlow id="F10" sourceRef="ICE_Breach" targetRef="T_Breach" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Breach" targetRef="EE_Breach" />
    <bpmn:sequenceFlow id="F12" sourceRef="EBG_SLA1" targetRef="ICE_FirstResp1" />
    <bpmn:sequenceFlow id="F13" sourceRef="ICE_FirstResp1" targetRef="EE_SLAOk1" />
    <bpmn:sequenceFlow id="F14" sourceRef="EBG_SLA2" targetRef="ICE_FirstResp2" />
    <bpmn:sequenceFlow id="F15" sourceRef="ICE_FirstResp2" targetRef="EE_SLAOk2" />
    <bpmn:sequenceFlow id="F16" sourceRef="GW_Split" targetRef="T_Notify" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Notify" targetRef="T_AIProposal" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_AIProposal" targetRef="GW_Free" />
    <bpmn:sequenceFlow id="F19" name="Да" sourceRef="GW_Free" targetRef="T_Take" />
    <bpmn:sequenceFlow id="F20" name="Нет" sourceRef="GW_Free" targetRef="T_HeadAssign" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_Take" targetRef="GW_Merge1" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_HeadAssign" targetRef="GW_Merge1" />
    <bpmn:sequenceFlow id="F23" sourceRef="GW_Merge1" targetRef="GW_MergeLoop" />
    <bpmn:sequenceFlow id="F24" sourceRef="GW_MergeLoop" targetRef="T_Check" />
    <bpmn:sequenceFlow id="F25" sourceRef="T_Check" targetRef="GW_Competent" />
    <bpmn:sequenceFlow id="F26" name="Нет" sourceRef="GW_Competent" targetRef="T_Escalate" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_Escalate" targetRef="GW_MergeLoop" />
    <bpmn:sequenceFlow id="F28" name="Да" sourceRef="GW_Competent" targetRef="GW_Merge2" />
