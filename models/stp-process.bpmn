    <bpmn:sequenceFlow id="F41" name="Да" sourceRef="GW_Solved" targetRef="T_CloseDecision" />
    <bpmn:sequenceFlow id="F42" name="Нет (нужна доп. работа)" sourceRef="GW_Solved" targetRef="GW_MergeLoop" />
    <bpmn:sequenceFlow id="F43" sourceRef="BT_3days" targetRef="GW_CloseNoReply" />
